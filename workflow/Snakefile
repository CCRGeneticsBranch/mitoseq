# Consensus read calling per UMI based on recommended best practices by fgbio: https://github.com/fulcrumgenomics/fgbio/blob/main/docs/FastqToConsensus-RnD.smk

# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
SCRIPTSDIR = config["scriptsdir"]

# Get list of samples
manifest = pd.read_table(config["manifest"])
SAMPLES =  manifest['Sample'].unique()
UBAM = dict(zip(manifest['Sample'], manifest['uBam']))

# Get paired sample dictionary
paired = manifest[manifest['Normal'].notna()]
PAIRS = dict(zip(paired['Sample'], paired['Normal']))

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Define genomes
genome = config['genome']

include: "rules/qc.smk"
include: "rules/variant_calling.smk"

# Rules

localrules: link_uBam

rule all:
    input:
        # Filtered reads
        expand(join(RESULTSDIR,"bam","{samples}.cons.filtered.bam"),samples=SAMPLES),

        # QC
        expand(join(RESULTSDIR,"qc","fastqc","{samples}.unmapped_fastqc.html"),samples=SAMPLES),
        expand(join(RESULTSDIR,"qc","samtools","{samples}.flagstat"),samples=SAMPLES),
        expand(join(RESULTSDIR,"qc","samtools","{samples}.idxstats"),samples=SAMPLES),
        expand(join(RESULTSDIR,"qc","picard","{samples}.hs_metrics"),samples=SAMPLES),
        join(RESULTSDIR,"qc","multiqc_report.html"),

        # Interval list
        join(RESULTSDIR,"bait.interval"),
        join(RESULTSDIR,"target.interval"),

        # Variant calling
        expand(join(RESULTSDIR,"variants","mutect2_chrM","{samples}.vcf"),samples=SAMPLES),
        expand(join(RESULTSDIR,"variants","mutect2_chrM","{samples}.marked.vcf"),samples=SAMPLES),
        expand(join(RESULTSDIR,"variants","mutect2_chrM","{samples}.filtered.vcf"),samples=SAMPLES),
        expand(join(RESULTSDIR,"variants","mutect2","{samples}.vcf"),samples=PAIRS.keys()),
        expand(join(RESULTSDIR,"variants","mutect2","{samples}.marked.vcf"),samples=PAIRS.keys()),
        expand(join(RESULTSDIR,"variants","mutect2","{samples}.filtered.vcf"),samples=PAIRS.keys()),
        expand(join(RESULTSDIR,"variants","varscan","{samples}.vcf"),samples=PAIRS.keys()),
        expand(join(RESULTSDIR,"variants","varscan","{samples}.filtered.vcf"),samples=PAIRS.keys())
        
rule link_uBam:
    """
    Link uBam from raw data directory with updated names
    """
    input:
        ubam=lambda wildcards: f"{UBAM[wildcards.sample]}",
    output:
        ubam=join(RESULTSDIR,"uBam","{sample}.unmapped.bam"),
    shell:
        """
        ln -s {input.ubam} {output.ubam}
        """

rule align_bam:
    """Takes an unmapped BAM and generates an aligned BAM using bwa and ZipperBams."""
    input:
        bam = join(RESULTSDIR,"uBam","{sample}.unmapped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.mapped.bam")
    params:
        ref = config[genome]['ref'],
        bwa_ref = config[genome]['bwa_ref']
    threads:
        getthreads("align_bam")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"],
        TOOLS["samtools"],
        TOOLS["bwa"]
    shell:
        """
        samtools fastq {input.bam} \
          | bwa mem -t {threads} -p -K 150000000 -Y {params.bwa_ref} - \
          | java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io ZipperBams \
              --unmapped {input.bam} \
              --ref {params.ref} \
              --output {output.bam}
        """

rule group_reads:
    """Group the raw reads by UMI and position ready for consensus calling."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.mapped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.grouped.bam"),
        stats = join(RESULTSDIR,"qc","fgbio","{sample}.grouped-family-sizes.txt")
    params:
        allowed_edits = 1
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"]
    shell:
        """
        java -Xmx8g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io GroupReadsByUmi \
          --input {input.bam} \
          --strategy Adjacency \
          --edits {params.allowed_edits} \
          --output {output.bam} \
          --family-size-histogram {output.stats}
        """

rule call_consensus_reads:
    """Call consensus reads from the grouped reads."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.grouped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.cons.unmapped.bam")
    params:
        min_reads = 1,
        min_base_qual = 20
    threads:
        getthreads("call_consensus_reads")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"]
    shell:
        """
        java -Xmx20g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 CallMolecularConsensusReads \
          --input {input.bam} \
          --output {output.bam} \
          --min-reads {params.min_reads} \
          --min-input-base-quality {params.min_base_qual} \
          --consensus-call-overlapping-bases \
          --threads {threads}
        """

rule align_consensus_bam:
    """Takes the unmapped consensus BAM and generates an aligned BAM using bwa and ZipperBams."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.cons.unmapped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.cons.mapped.bam")
    params:
        ref = config[genome]['ref'],
        bwa_ref = config[genome]['bwa_ref']
    threads:
        getthreads("align_bam")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"],
        TOOLS["samtools"],
        TOOLS["bwa"]
    shell:
        """
        samtools fastq {input.bam} \
          | bwa mem -t {threads} -p -K 150000000 -Y {params.bwa_ref} - \
          | java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io ZipperBams \
              --unmapped {input.bam} \
              --ref {params.ref} \
              --output {output.bam} \
              --tags-to-reverse Consensus \
              --tags-to-revcomp Consensus
        """

rule filter_consensus_reads:
    """Filters the consensus reads and then sorts into coordinate order."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.cons.mapped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.cons.filtered.bam")
    params:
        ref = config[genome]['ref'],
        min_reads = 1,
        min_base_qual = 30,
        max_error_rate = 0.1
    threads:
        getthreads("filter_consensus_reads")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"],
        TOOLS["samtools"]
    shell:
        """
        java -Xmx8g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 0 FilterConsensusReads \
          --input {input.bam} \
          --output /dev/stdout \
          --ref {params.ref} \
          --min-reads {params.min_reads} \
          --min-base-quality {params.min_base_qual} \
          --max-base-error-rate {params.max_error_rate} \
          | samtools sort --threads {threads} -o {output.bam} --write-index
        """
