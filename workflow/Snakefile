# Consensus read calling per UMI based on recommended best practices by fgbio: https://github.com/fulcrumgenomics/fgbio/blob/main/docs/FastqToConsensus-RnD.smk

# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
SCRIPTSDIR = config["scriptsdir"]

# Get list of samples
manifest = pd.read_table(config["manifest"])
SAMPLES =  manifest['Sample'].unique()
UBAM = dict(zip(manifest['Sample'], manifest['uBam']))

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Define genomes
genome = config['genome']

# Rules
#ruleorder: call_consensus_reads > fastq_to_ubam

rule all:
    input:
        # Filtered reads
        expand(join(RESULTSDIR,"bam","{samples}.cons.filtered.bam"),samples=SAMPLES),
        
rule link_uBam:
    """
    Link uBam from raw data directory with updated names
    """
    input:
        ubam=lambda wildcards: f"{UBAM[wildcards.sample]}",
    output:
        ubam=join(RESULTSDIR,"uBam","{sample}.unmapped.bam"),
    shell:
        """
        ln -s {input.ubam} {output.ubam}
        """

rule fastq_to_ubam:
    """Generates a uBam from R1 and R2 fastq files."""
    input:
        r1 = join(RESULTSDIR,"fastq","{sample}.R1.fastq.gz"),
        r2 = join(RESULTSDIR,"fastq","{sample}.R2.fastq.gz")
    params:
        rs1 = "8M+T",
        rs2 = "8M+T"
    output:
        bam = temp(join(RESULTSDIR,"bam","{sample}.unmapped.bam"))
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"]
    log:
        join("logs","fastq_to_ubam.{sample}.log")
    shell:
        """
        java -Xmx8g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io FastqToBam
          --input {input.r1} {input.r2}
          --read-structures {params.rs1} {params.rs2}
          --sample {wildcards.sample}
          --library {wildcards.sample}
          --platform-unit flowcell.lane
          --output {output.bam} &> {log}
        """

rule align_bam:
    """Takes an unmapped BAM and generates an aligned BAM using bwa and ZipperBams."""
    input:
        bam = join(RESULTSDIR,"uBam","{sample}.unmapped.bam"),
        ref = config[genome]['ref']
    output:
        bam = join(RESULTSDIR,"bam","{sample}.mapped.bam")
    threads:
        getthreads("align_bam")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"],
        TOOLS["samtools"],
        TOOLS["bwa"]
    log:
        join("logs","align_bam.{sample}.log")
    shell:
        """
        (
        samtools fastq {input.bam}
          | bwa mem -t {threads} -p -K 150000000 -Y {input.ref} -
          | java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io ZipperBams
              --unmapped {input.bam}
              --ref {input.ref}
              --output {output.bam}
              --tags-to-reverse Consensus
              --tags-to-revcomp Consensus
        ) &> {log}"
        """

rule group_reads:
    """Group the raw reads by UMI and position ready for consensus calling."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.mapped.bam")
    output:
        bam = join(RESULTSDIR,"bam","{sample}.grouped.bam"),
        stats = join(RESULTSDIR,"bam","{sample}.grouped-family-sizes.txt")
    params:
        allowed_edits = 1,
        min_map = 1
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"]
    log:
        join("logs","group_reads.{sample}.log")
    shell:
        """
        java -Xmx8g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 --async-io GroupReadsByUmi
          --input {input.bam}
          --strategy Edit
          --edits {params.allowed_edits}
          --min-map-q {params.min_map}
          --output {output.bam}
          --family-size-histogram {output.stats}
          &> {log}
        """

rule call_consensus_reads:
    """Call consensus reads from the grouped reads."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.grouped.bam"),
    output:
        bam = temp(join(RESULTSDIR,"bam","{sample}.cons.unmapped.bam")),
    params:
        min_reads = 1,
        min_base_qual = 20
    threads:
        getthreads("call_consensus_reads")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"]
    log:
        join("logs","call_consensus_reads.{sample}.log")
    shell:
        """
        java -Xmx20g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 1 CallMolecularConsensusReads
          --input {input.bam}
          --output {output.bam}
          --min-reads {params.min_reads}
          --min-input-base-quality {params.min_base_qual}
          --consensus-call-overlapping-bases
          --threads {threads}
          &> {log}
        """

rule filter_consensus_reads:
    """Filters the consensus reads and then sorts into coordinate order."""
    input:
        bam = join(RESULTSDIR,"bam","{sample}.cons.unmapped.bam"),
        ref = config[genome]['ref'],
    output:
        bam = join(RESULTSDIR,"bam","{sample}.cons.filtered.bam"),
    params:
        min_reads = 1,
        min_base_qual = 40,
        max_error_rate = 0.2
    threads:
        getthreads("filter_consensus_reads")
    envmodules:
        TOOLS["java"],
        TOOLS["fgbio"],
        TOOLS["samtools"]
    log:
        join("logs","filter_consensus_reads.{sample}.log")
    shell:
        """
        (
        java -Xmx8g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR --compression 0 FilterConsensusReads
          --input {input.bam}
          --output /dev/stdout
          --ref {input.ref}
          --min-reads {params.min_reads}
          --min-base-quality {params.min_base_qual}
          --max-base-error-rate {params.max_error_rate}
          | samtools sort --threads {threads} -o {output.bam}##idx##{output.bam}.bai --write-index
        ) &> {log}
        """